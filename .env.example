# Copy to `.env` and fill in the provider you want. Pick ONE.
# InsightCrew reads NOOA_PROVIDER to decide which block to use.

# --- Option A: NVIDIA build.nvidia.com NIM (FREE, no GPU). Recommended. ---
NOOA_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: pick a different NIM model
# NVIDIA_MODEL=nvidia_nim/meta/llama-3.1-70b-instruct

# --- Option B: Local model via Ollama (FREE, no key). Great in Colab. ---
# NOOA_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_BASE_URL=http://localhost:11434

# --- Option C: Local model via vLLM (FREE, no key). Great on Kaggle. ---
# NOOA_PROVIDER=vllm
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# VLLM_BASE_URL=http://localhost:8000/v1

# --- Option D: Google AI Studio free tier ---
# NOOA_PROVIDER=gemini
# GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxx

# --- Option E: OpenAI (paid) ---
# NOOA_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
